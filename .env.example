OPENAI_API_KEY=
# Optional. May point to OpenAI or a trusted OpenAI-compatible gateway.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.5

# Alpaca paper and market data
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_API_BASE_URL=https://paper-api.alpaca.markets/v2
ALPACA_DATA_FEED=iex

# Optional local Dashboard API token
OPEN_COMPOSER_DASHBOARD_TOKEN=

# Remote Dashboard daemon and Vercel BFF
OC_REMOTE_BASE_URL=https://oc-api.example.com
OC_REMOTE_SHARED_SECRET=
OC_DASHBOARD_PASSWORD_HASH=
OC_DASHBOARD_SESSION_SECRET=
OC_DASHBOARD_OWNER=owner
# Optional. When unset, local dashboard CORS only allows localhost/127.0.0.1 origins.
OC_DASHBOARD_ALLOWED_ORIGIN=https://your-vercel-app.example
OC_DASHBOARD_SESSION_TTL_SECONDS=604800

# Longbridge market data
LONGBRIDGE_APP_KEY=
LONGBRIDGE_APP_SECRET=
LONGBRIDGE_ACCESS_TOKEN=
LONGBRIDGE_LANGUAGE=en
LONGBRIDGE_ENABLE_OVERNIGHT=false

# Optional context sources
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT=open-composer/0.1 your-email@example.com

[Unit]
Description=Open Composer Alpaca Paper strategy runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/root/.paseo/worktrees/229b4rkt/aquatic-koala
Environment=OC_EXTRA_ENV_FILE=/root/.paseo/worktrees/229b4rkt/idiotic-donkey/.env
Environment=UV_CACHE_DIR=/tmp/uv-cache
ExecStart=/root/.local/bin/uv run oc run paper nasdaq_beta_exposure_router_daily --max-cycles 1 --allow-paper-orders --no-review
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/root/.paseo/worktrees/229b4rkt/aquatic-koala

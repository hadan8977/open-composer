[Unit]
Description=Open Composer Remote Dashboard daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=opencomposer
Group=opencomposer
WorkingDirectory=/srv/open-composer/repo
EnvironmentFile=/srv/open-composer/repo/.env
ExecStart=/usr/bin/env uv run oc remote serve --host 127.0.0.1 --port 8787
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/open-composer/repo

[Install]
WantedBy=multi-user.target

{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Immutable Alpaca Snapshot Contract v2",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "iter_id",
        "provider",
        "feed",
        "adjustments",
        "symbol_asof",
        "symbol_asof_semantics",
        "currency",
        "spin_off_handling",
        "historical_vintage_claim_allowed",
        "session_scope",
        "latest_frozen_session",
        "symbols",
        "timeframes",
        "bundle_role",
        "candidate_required_dataset",
        "immutable_output_root",
        "manifest_requirements",
        "forward_fill_allowed",
        "zero_return_substitution_allowed",
        "partial_completed_session_allowed",
        "overwrite_existing_snapshot_allowed",
    ],
    "properties": {
        "schema_version": {"const": 2},
        "iter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"},
        "provider": {"const": "alpaca"},
        "feed": {"const": "sip"},
        "adjustments": {
            "type": "array",
            "items": {"enum": ["raw", "split", "dividend", "all"]},
            "minItems": 1,
            "uniqueItems": true,
        },
        "symbol_asof": {"type": "string", "format": "date"},
        "symbol_asof_semantics": {"const": "symbol_mapping_only_not_historical_data_vintage"},
        "currency": {"const": "USD"},
        "spin_off_handling": {"const": "provider_all_composite_only_no_independent_decomposition"},
        "historical_vintage_claim_allowed": {"const": false},
        "session_scope": {"const": "regular"},
        "latest_frozen_session": {"type": "string", "format": "date"},
        "symbols": {
            "type": "array",
            "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"},
            "minItems": 1,
            "uniqueItems": true,
        },
        "timeframes": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {"enum": ["daily", "1m", "5m", "15m", "30m"]},
            "additionalProperties": {"$ref": "#/$defs/timeframe"},
        },
        "bundle_role": {"enum": ["candidate_research", "selection_prohibited_execution_shadow"]},
        "candidate_required_dataset": {"type": ["string", "null"]},
        "immutable_output_root": {"type": "string", "minLength": 1},
        "manifest_requirements": {
            "type": "array",
            "items": {"type": "string"},
            "minItems": 1,
            "uniqueItems": true,
        },
        "forward_fill_allowed": {"const": false},
        "zero_return_substitution_allowed": {"const": false},
        "partial_completed_session_allowed": {"const": false},
        "overwrite_existing_snapshot_allowed": {"const": false},
    },
    "$defs": {
        "timeframe": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "symbols",
                "adjustments",
                "requested_start",
                "requested_end_exclusive",
                "required_for",
            ],
            "properties": {
                "symbols": {
                    "type": ["array", "null"],
                    "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"},
                    "minItems": 1,
                    "uniqueItems": true,
                },
                "adjustments": {
                    "type": "array",
                    "items": {"enum": ["raw", "split", "dividend", "all"]},
                    "minItems": 1,
                    "uniqueItems": true,
                },
                "requested_start": {"type": "string", "format": "date-time"},
                "requested_end_exclusive": {"type": "string", "format": "date-time"},
                "required_for": {"type": "array", "items": {"type": "string"}, "minItems": 1},
            },
        }
    },
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventFeature",
  "type": "object",
  "required": [
    "symbol",
    "timestamp",
    "published_at",
    "fetched_at",
    "visible_at",
    "source",
    "dedupe_key",
    "schema_version"
  ],
  "properties": {
    "symbol": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "published_at": {"type": "string", "format": "date-time"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "visible_at": {"type": "string", "format": "date-time"},
    "first_seen_at": {"type": "string", "format": "date-time"},
    "revision_id": {"type": "string"},
    "version_id": {"type": "string"},
    "rights_scope": {"type": "string"},
    "availability_quality": {"type": "string"},
    "acquisition_mode": {"type": "string"},
    "source": {"type": "string"},
    "dedupe_key": {"type": "string"},
    "summary": {"type": "string"},
    "sentiment": {"enum": ["positive", "neutral", "negative", "unknown"]},
    "model": {"type": "string"},
    "input_hash": {"type": "string"},
    "prompt_hash": {"type": "string"},
    "schema_version": {"type": "string"},
    "features": {"type": "object"},
    "evidence": {
      "type": "object",
      "required": [
        "single_modality_baseline_metric",
        "marginal_lift_metric",
        "missing_modality_robustness"
      ],
      "properties": {
        "single_modality_baseline_metric": {"type": "string"},
        "marginal_lift_metric": {"type": "string"},
        "missing_modality_robustness": {"type": "string"},
        "fixture_path": {"type": "string"},
        "notes": {"type": "string"}
      }
    }
  }
}

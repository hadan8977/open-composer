{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-composer.local/schemas/core_satellite_r7_feature_packet.schema.json",
  "title": "R7 Point-In-Time Event Feature Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "timestamp",
    "symbol",
    "modality",
    "published_at",
    "fetched_at",
    "visible_at",
    "decision_at",
    "source",
    "source_document_id",
    "source_url",
    "input_hash",
    "prompt_hash",
    "model",
    "dedupe_key",
    "evidence_spans",
    "evidence",
    "features"
  ],
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "packet_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"
    },
    "modality": {
      "enum": [
        "sec_filing",
        "news",
        "earnings_release",
        "earnings_calendar",
        "earnings_call"
      ]
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "visible_at": {
      "type": "string",
      "format": "date-time"
    },
    "decision_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_document_id": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "prompt_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "dedupe_key": {
      "type": "string",
      "minLength": 1
    },
    "evidence_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_locator",
          "start",
          "end",
          "quote_hash"
        ],
        "properties": {
          "source_locator": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 0
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "quote_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_modality_baseline_metric",
        "marginal_lift_metric",
        "missing_modality_robustness"
      ],
      "properties": {
        "single_modality_baseline_metric": {
          "type": "string",
          "minLength": 1
        },
        "marginal_lift_metric": {
          "type": "string",
          "minLength": 1
        },
        "missing_modality_robustness": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "catalyst_strength",
        "risk_event_score",
        "novelty",
        "guidance_change",
        "qa_challenge"
      ],
      "properties": {
        "catalyst_strength": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "risk_event_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "novelty": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "guidance_change": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "qa_challenge": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}

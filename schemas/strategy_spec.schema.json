{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StrategySpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "timeframe", "universe", "lifecycle", "entry", "exit", "risk", "execution"],
  "properties": {
    "name": {"type": "string"},
    "description": {"type": "string"},
    "timeframe": {"enum": ["1m", "5m", "15m", "30m", "1h", "4h", "daily", "weekly"]},
    "universe": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "lifecycle": {"enum": ["draft", "approved", "active", "retired"]},
    "position_direction": {"enum": ["long_only", "short_only", "long_short"]},
    "entry": {"$ref": "#/$defs/ruleBlock"},
    "exit": {"$ref": "#/$defs/ruleBlock"},
    "risk": {"type": "object"},
    "portfolio": {"$ref": "#/$defs/portfolioConfig"},
    "costs": {"type": "object"},
    "execution": {"type": "object"},
    "data": {"type": "object"},
    "data_assumptions": {"type": "object"},
    "llm_review": {"type": "object"},
    "factors": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/factorConfig"}
    },
    "notes": {"type": "object"},
    "research_design": {"$ref": "#/$defs/researchDesign"},
    "required_capabilities": {"type": "array", "items": {"type": "string"}},
    "execution_policy": {"type": ["object", "null"]},
    "reality_model": {"type": ["object", "null"]},
    "model": {
      "anyOf": [
        {"$ref": "#/$defs/mlModelConfig"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "ruleBlock": {
      "type": "object",
      "properties": {
        "all": {"type": "array", "items": {"type": "string"}},
        "any": {"type": "array", "items": {"type": "string"}}
      }
    },
    "researchDesign": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "iter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"},
        "workflow_only_ungated_draft": {"type": "boolean"},
        "campaign_contract_path": {"type": "string"},
        "candidate_manifest_path": {"type": "string"},
        "candidate_policy_contract_path": {"type": "string"},
        "data_feasibility_path": {"type": "string"},
        "universe_contract_path": {"type": "string"},
        "data_contract_path": {"type": "string"},
        "holdout_contract_path": {"type": "string"},
        "cost_contract_path": {"type": "string"},
        "cumulative_trial_contract_path": {"type": "string"},
        "source_cards_path": {"type": "string"},
        "source_card_claim_ids": {"type": "array", "items": {"type": "string"}},
        "preregistration_lock_path": {"type": "string"},
        "parameter_space": {
          "type": "object",
          "additionalProperties": {"type": "array"}
        },
        "candidate_budget": {"type": ["integer", "null"], "minimum": 1},
        "selection_objective": {"type": "string"},
        "anti_overfit_notes": {"type": "array", "items": {"type": "string"}},
        "validation_plan": {"type": "array", "items": {"type": "string"}}
      }
    },
    "mlLabel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "forward_return",
            "forward_direction",
            "path_survival",
            "net_incremental_policy_value"
          ]
        },
        "horizon_bars": {"type": ["integer", "null"], "minimum": 1, "maximum": 60},
        "horizon_mode": {"enum": ["fixed_bars", "next_scheduled_review_open"]},
        "review_schedule": {"type": ["string", "null"], "enum": ["calendar_month_end", null]},
        "maximum_horizon_bars": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 60
        },
        "threshold_pct": {"type": ["number", "null"]},
        "max_drawdown_pct": {"type": ["number", "null"], "minimum": 0},
        "min_terminal_return_pct": {"type": ["number", "null"]},
        "path_drawdown_reference": {
          "type": ["string", "null"],
          "enum": ["start_open", "running_open_peak", null]
        },
        "baseline_policy": {"type": ["string", "null"]},
        "alternative_policy": {"type": ["string", "null"]},
        "value_measure": {"type": ["string", "null"], "enum": ["log_wealth_ratio", null]},
        "one_way_cost_bps": {"type": ["number", "null"], "minimum": 0},
        "terminal_rejoin_cost_included": {"type": ["boolean", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"horizon_mode": {"const": "next_scheduled_review_open"}}},
          "then": {
            "required": ["review_schedule", "horizon_bars", "maximum_horizon_bars"],
            "properties": {"horizon_bars": {"const": null}}
          }
        },
        {
          "if": {"properties": {"type": {"const": "net_incremental_policy_value"}}},
          "then": {
            "required": [
              "horizon_mode",
              "baseline_policy",
              "alternative_policy",
              "value_measure",
              "one_way_cost_bps",
              "terminal_rejoin_cost_included"
            ],
            "properties": {"horizon_mode": {"const": "next_scheduled_review_open"}}
          }
        }
      ]
    },
    "mlTraining": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "window_bars": {"type": "integer", "minimum": 120},
        "retrain_every_bars": {"type": ["integer", "null"], "minimum": 5},
        "retrain_schedule": {"enum": ["fixed_bars", "calendar_month_end"]},
        "test_window_bars": {"type": "integer", "minimum": 21},
        "purge_bars": {"type": ["integer", "null"], "minimum": 0},
        "embargo_bars": {"type": "integer", "minimum": 0},
        "seed": {"type": "integer"}
      }
    },
    "mlSelection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "method": {"enum": ["threshold", "top_quantile"]},
        "threshold": {"type": ["number", "null"]},
        "quantile": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "operator": {
          "enum": [
            "greater_than_or_equal",
            "less_than_or_equal",
            "lower_bound_strictly_greater_than"
          ]
        }
      }
    },
    "mlAbstention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibration_method",
        "calibration_fraction",
        "minimum_fit_rows",
        "minimum_calibration_rows",
        "fallback_candidate_id",
        "insufficient_data_action"
      ],
      "properties": {
        "calibration_method": {
          "enum": [
            "chronological_split_conformal_lower_bound",
            "chronological_platt_scaling"
          ]
        },
        "calibration_fraction": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 0.5},
        "minimum_fit_rows": {"type": "integer", "minimum": 1},
        "minimum_calibration_rows": {"type": "integer", "minimum": 1},
        "minimum_positive_class_rows": {"type": ["integer", "null"], "minimum": 1},
        "minimum_negative_class_rows": {"type": ["integer", "null"], "minimum": 1},
        "minimum_calibration_positive_class_rows": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "minimum_calibration_negative_class_rows": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "target_coverage": {"type": ["number", "null"], "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "quantile_method": {"type": ["string", "null"], "enum": ["higher", null]},
        "calibrator": {
          "anyOf": [
            {"$ref": "#/$defs/mlProbabilityCalibrator"},
            {"type": "null"}
          ]
        },
        "fallback_candidate_id": {"type": "string", "minLength": 1},
        "insufficient_data_action": {"const": "exact_target_identity_fallback"}
      }
    },
    "mlProbabilityCalibrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "C", "max_iter"],
      "properties": {
        "kind": {"const": "logistic_regression"},
        "C": {"type": "number", "exclusiveMinimum": 0},
        "penalty": {"const": "l2"},
        "solver": {"const": "lbfgs"},
        "max_iter": {"type": "integer", "minimum": 1},
        "use_training_seed": {"type": "boolean"}
      }
    },
    "mlPolicyAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "apply_at", "hold_until"],
      "properties": {
        "kind": {"enum": ["invert_tactical_sleeve", "shift_portfolio_weight"]},
        "source_symbol": {"type": ["string", "null"]},
        "destination_symbol": {"type": ["string", "null"]},
        "portfolio_weight_delta": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "apply_at": {"const": "next_regular_session_open"},
        "hold_until": {"const": "next_scheduled_review_open"}
      }
    },
    "mlModelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features"],
      "properties": {
        "kind": {
          "enum": [
            "lightgbm_regressor",
            "lightgbm_classifier",
            "ridge_regressor",
            "logistic_regression_classifier"
          ]
        },
        "label": {"$ref": "#/$defs/mlLabel"},
        "features": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1
        },
        "training": {"$ref": "#/$defs/mlTraining"},
        "selection": {"$ref": "#/$defs/mlSelection"},
        "abstention": {
          "anyOf": [
            {"$ref": "#/$defs/mlAbstention"},
            {"type": "null"}
          ]
        },
        "action": {
          "anyOf": [
            {"$ref": "#/$defs/mlPolicyAction"},
            {"type": "null"}
          ]
        },
        "preprocessing": {"const": "standard_scaler"},
        "hyperparameters": {"type": "object"},
        "baseline": {"enum": ["linear_composite", "none"]}
      }
    },
    "portfolioConfig": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["cross_sectional_execution_profile"],
            "properties": {
              "cross_sectional_execution_profile": {
                "const": "monthly_equal_weight_bil_reserve"
              }
            }
          },
          "then": {
            "required": [
              "mode",
              "position_weight_enforcement",
              "rebalance_schedule",
              "weighting",
              "reserve_symbol",
              "reserve_exempt_from_max_symbol_weight"
            ],
            "properties": {
              "mode": {"const": "cross_sectional_momentum"},
              "position_weight_enforcement": {"const": "entry_only"},
              "rebalance_schedule": {"const": "calendar_month_end"},
              "weighting": {"const": "equal_weight"},
              "reserve_symbol": {"const": "BIL"},
              "reserve_exempt_from_max_symbol_weight": {"const": true}
            }
          }
        },
        {
          "if": {
            "required": ["cross_sectional_execution_profile"],
            "properties": {
              "cross_sectional_execution_profile": {
                "const": "dynamic_theme_mwf_bil_reserve"
              }
            }
          },
          "then": {
            "required": [
              "mode",
              "position_weight_enforcement",
              "rebalance_schedule",
              "weighting",
              "reserve_symbol",
              "reserve_exempt_from_max_symbol_weight"
            ],
            "properties": {
              "mode": {"const": "cross_sectional_momentum"},
              "position_weight_enforcement": {"const": "entry_only"},
              "rebalance_schedule": {"const": "monday_wednesday_friday"},
              "weighting": {"const": "risk_budgeted_score"},
              "reserve_symbol": {"const": "BIL"},
              "reserve_exempt_from_max_symbol_weight": {"const": true}
            }
          }
        }
      ],
      "properties": {
        "mode": {
          "enum": [
            "single_symbol",
            "adaptive_intraday_internal_router",
            "hybrid_adaptive_router",
            "beta_exposure_router",
            "core_beta_satellite_router",
            "momentum_signal_router",
            "cross_sectional_momentum",
            "etf_structural_family"
          ]
        },
        "max_symbols_per_day": {"type": ["integer", "null"], "minimum": 1},
        "gross_exposure_limit": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_symbol_weight": {
          "type": ["number", "null"],
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "same_day_flatten": {"type": "boolean"},
        "duplicate_signal_policy": {"enum": ["stable_signal_id", "allow_duplicates"]},
        "selected_route_label": {"type": ["string", "null"]},
        "cross_sectional_execution_profile": {
          "enum": [
            "generic",
            "monthly_equal_weight_bil_reserve",
            "dynamic_theme_mwf_bil_reserve"
          ]
        },
        "position_weight_enforcement": {"enum": ["entry_only", "continuous"]},
        "rebalance_schedule": {
          "enum": ["every_bar", "calendar_month_end", "monday_wednesday_friday"]
        },
        "weighting": {"enum": ["engine_default", "equal_weight", "risk_budgeted_score"]},
        "reserve_symbol": {"type": ["string", "null"]},
        "reserve_exempt_from_max_symbol_weight": {"type": "boolean"},
        "etf_structural": {
          "anyOf": [
            {"$ref": "#/$defs/etfStructuralFamilyConfig"},
            {"type": "null"}
          ]
        }
      }
    },
    "etfTrendRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fast_sma_sessions": {"type": "integer", "minimum": 2},
        "slow_sma_sessions": {"type": "integer", "minimum": 2},
        "momentum_sessions": {"type": "integer", "minimum": 2},
        "required_positive_votes": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "etfSectorRelativeRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbols"],
      "properties": {
        "symbols": {
          "type": "array",
          "items": {"type": "string"},
          "minItems": 1,
          "uniqueItems": true
        },
        "fast_momentum_sessions": {"type": "integer", "minimum": 2},
        "slow_momentum_sessions": {"type": "integer", "minimum": 2},
        "trend_sma_sessions": {"type": "integer", "minimum": 2},
        "benchmark_symbol": {"type": "string", "minLength": 1},
        "score_method": {"const": "equal_weight_mean_relative_return"},
        "weighting": {"const": "equal_weight"},
        "top_n": {"type": "integer", "minimum": 1},
        "hold_rank": {"type": "integer", "minimum": 1},
        "hold_buffer_policy": {"const": "retain_through_hold_rank_then_fill_top_n"},
        "tie_break": {"const": "symbol_ascending"}
      }
    },
    "etfStructuralRiskOverlay": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "volatility_lookback_sessions": {"type": "integer", "minimum": 2},
        "volatility_reference_symbol": {"type": "string", "minLength": 1},
        "volatility_measure": {"const": "annualized_close_to_close"},
        "annualization_sessions": {"type": "integer", "minimum": 2},
        "medium_volatility_threshold": {"type": "number", "exclusiveMinimum": 0},
        "high_volatility_threshold": {"type": "number", "exclusiveMinimum": 0},
        "medium_exposure_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "high_exposure_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "volatility_scope": {"const": "all_non_reserve_sleeves"},
        "drawdown_lookback_sessions": {"type": "integer", "minimum": 2},
        "drawdown_reference_symbol": {"type": "string", "minLength": 1},
        "drawdown_trigger": {
          "type": "number",
          "minimum": -1,
          "exclusiveMaximum": 0
        },
        "drawdown_exposure_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "drawdown_scope": {"const": "equity_sleeves"},
        "recovery_sma_sessions": {"type": "integer", "minimum": 2},
        "recovery_rule": {"const": "reference_close_above_sma"}
      }
    },
    "etfStructuralFamilyConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "enabled_sleeves", "sector_relative"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "rebalance_frequency": {"const": "calendar_month_end"},
        "decision_anchor": {"const": "last_session_close"},
        "execution_anchor": {"const": "next_session_open"},
        "core_symbol": {"type": "string", "minLength": 1},
        "reserve_symbol": {"type": "string", "minLength": 1},
        "diversifier_symbols": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "diversifier_weighting": {"const": "equal_weight"},
        "enabled_sleeves": {
          "type": "array",
          "items": {"enum": ["core", "diversifiers", "sectors"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "core_budget": {"type": "number", "minimum": 0, "maximum": 1},
        "diversifier_budget": {"type": "number", "minimum": 0, "maximum": 1},
        "sector_budget": {"type": "number", "minimum": 0, "maximum": 1},
        "core_trend": {"$ref": "#/$defs/etfTrendRule"},
        "diversifier_trend": {"$ref": "#/$defs/etfTrendRule"},
        "sector_relative": {"$ref": "#/$defs/etfSectorRelativeRule"},
        "risk_overlay": {
          "anyOf": [
            {"$ref": "#/$defs/etfStructuralRiskOverlay"},
            {"type": "null"}
          ]
        },
        "reserve_receives_unallocated": {"type": "boolean"},
        "natural_weight_drift_between_rebalances": {"type": "boolean"}
      }
    },
    "crossSectionalRankTransformParams": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transform",
        "rank_method",
        "full_sample_fit",
        "components",
        "coefficients",
        "population",
        "rank_ascending",
        "tie_break",
        "apply_at"
      ],
      "properties": {
        "transform": {
          "const": "weighted_sum_of_component_cross_sectional_percentile_ranks"
        },
        "rank_method": {"const": "percentile_rank_by_decision_session"},
        "full_sample_fit": {"const": false},
        "components": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "coefficients": {
          "type": "array",
          "items": {"type": "number"},
          "minItems": 1
        },
        "population": {"const": "rankable_symbols_with_finite_history"},
        "rank_ascending": {"const": true},
        "tie_break": {"const": "symbol_ascending"},
        "apply_at": {"const": "decision_close"},
        "placebo_operation": {
          "const": "per_decision_session_symbol_permutation"
        },
        "placebo_seed": {"type": "integer"},
        "placebo_mapping": {"const": "same_permutation_for_all_formula_columns"}
      },
      "dependentRequired": {
        "placebo_operation": ["placebo_seed", "placebo_mapping"],
        "placebo_seed": ["placebo_operation", "placebo_mapping"],
        "placebo_mapping": ["placebo_operation", "placebo_seed"]
      }
    },
    "factorConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"enum": ["expression", "llm_feature", "feature_packet", "factor_library"]},
        "expression": {"type": ["string", "null"]},
        "path": {"type": ["string", "null"]},
        "field": {"type": ["string", "null"]},
        "default": {"type": ["number", "boolean"]},
        "description": {"type": "string"},
        "factor_id": {"type": ["string", "null"]},
        "params": {
          "type": "object",
          "allOf": [
            {
              "if": {"required": ["transform"]},
              "then": {"$ref": "#/$defs/crossSectionalRankTransformParams"}
            }
          ]
        },
        "input_view": {"type": ["string", "null"]},
        "input_view_version": {"type": ["integer", "null"], "minimum": 1},
        "prompt_template_path": {"type": ["string", "null"]},
        "output_schema": {"$ref": "#/$defs/llmFactorOutputSchema"},
        "cache_policy": {"$ref": "#/$defs/llmFactorCachePolicy"},
        "model_ref": {"type": ["string", "null"]}
      }
    },
    "llmFactorOutputSchema": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "type": {"const": "object"},
        "required": {"type": "array", "items": {"type": "string"}},
        "properties": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        }
      }
    },
    "llmFactorCachePolicy": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "materialize_then_replay"},
        "key_fields": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}

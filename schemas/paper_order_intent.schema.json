{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperOrderIntent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "created_at", "client_order_id", "signal_id", "signal_record_hash",
    "signal_log_path", "strategy_name", "version_id", "spec_hash",
    "execution_policy_id", "execution_policy_hash", "order_style", "time_in_force", "authorization_id",
    "authorization_hash", "symbol", "side", "qty", "paper", "state"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^intent_[0-9a-f]{16}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "client_order_id": {"type": "string", "minLength": 1},
    "signal_id": {"type": "string", "minLength": 1},
    "signal_record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signal_log_path": {"type": "string", "minLength": 1},
    "strategy_name": {"type": "string", "minLength": 1},
    "version_id": {"type": "string", "pattern": "^ver_[0-9a-f]{12}$"},
    "spec_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_policy_id": {"type": "string", "minLength": 1},
    "execution_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "order_style": {"type": "string", "minLength": 1},
    "time_in_force": {"type": "string", "minLength": 1},
    "authorization_id": {"type": "string", "pattern": "^auth_[0-9a-f]{16}$"},
    "authorization_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_kind": {"type": ["string", "null"], "enum": ["canary", "full", null]},
    "symbol": {"type": "string", "minLength": 1},
    "side": {"enum": ["buy", "sell"]},
    "qty": {"type": "number", "exclusiveMinimum": 0},
    "reference_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "estimated_notional": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "requested_target_weight": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "effective_target_weight": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "pretrade_position_qty": {"type": ["number", "null"], "minimum": 0},
    "target_position_qty": {"type": ["number", "null"], "minimum": 0},
    "canary_position_limit_usd": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "risk_effect": {"type": ["string", "null"], "enum": ["increase", "reduce", null]},
    "reserved_at": {"type": ["string", "null"], "format": "date-time"},
    "paper": {"const": true},
    "state": {"const": "prepared"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-composer.local/schemas/pit_semantic_theme_forward_packet.schema.json",
  "title": "R12 Forward Semantic Theme Source Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_contract",
    "packet_id",
    "epoch_id",
    "source",
    "source_version_key",
    "provider_article_id",
    "version_id",
    "symbols",
    "title",
    "summary",
    "source_url",
    "published_at",
    "fetched_at",
    "first_seen_at",
    "visible_at",
    "input_hash",
    "rights_scope",
    "revision_id",
    "acquisition_mode",
    "dedupe_key"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "packet_contract": {"const": "pit_semantic_theme_forward_source_v1"},
    "packet_id": {"type": "string", "pattern": "^r12pkt_[a-f0-9]{24}$"},
    "epoch_id": {"type": "string", "minLength": 1},
    "source": {"enum": ["news.alpaca", "events.sec_filings"]},
    "source_version_key": {"type": "string", "minLength": 1},
    "provider_article_id": {"type": "string", "minLength": 1},
    "version_id": {"type": "string", "minLength": 1},
    "symbols": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,15}$"}
    },
    "title": {"type": "string", "minLength": 1, "maxLength": 2000},
    "summary": {"type": "string", "maxLength": 10000},
    "source_url": {"type": "string"},
    "published_at": {"type": "string", "format": "date-time"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "first_seen_at": {"type": "string", "format": "date-time"},
    "visible_at": {"type": "string", "format": "date-time"},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rights_scope": {"type": "string", "minLength": 1},
    "revision_id": {"type": "string", "minLength": 1},
    "acquisition_mode": {"const": "live_api_forward_only"},
    "dedupe_key": {"type": "string", "minLength": 1}
  }
}

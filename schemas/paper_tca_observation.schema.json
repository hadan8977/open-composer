{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperTCAObservation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "record_sha256",
    "strategy_name",
    "spec_hash",
    "execution_policy_id",
    "execution_policy_hash",
    "authorization_id",
    "authorization_hash",
    "broker_account_id_hash",
    "paper",
    "order_id",
    "fill_id",
    "client_order_id",
    "symbol",
    "side",
    "qty",
    "order_style",
    "time_in_force",
    "decision_price",
    "arrival_price",
    "fill_price",
    "decision_at",
    "submitted_at",
    "filled_at",
    "observed_at",
    "source_packet_path",
    "source_packet_sha256",
    "broker_receipt_path",
    "broker_receipt_sha256",
    "broker_sync_receipt_path",
    "broker_sync_receipt_sha256",
    "slippage_vs_decision_bps",
    "slippage_vs_arrival_bps",
    "fill_latency_ms",
    "ingested_at"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "observation_id": {"type": "string", "pattern": "^tca_[0-9a-f]{24}$"},
    "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "strategy_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"},
    "spec_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_policy_id": {"type": "string", "minLength": 1},
    "execution_policy_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "authorization_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "broker_account_id_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "paper": {"const": true},
    "order_id": {"type": "string", "minLength": 1},
    "fill_id": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "minLength": 1},
    "side": {"enum": ["buy", "sell"]},
    "qty": {"type": "number", "exclusiveMinimum": 0},
    "decision_price": {"type": "number", "exclusiveMinimum": 0},
    "arrival_price": {"type": "number", "exclusiveMinimum": 0},
    "official_open_price": {"type": "number", "exclusiveMinimum": 0},
    "vwap_price": {"type": "number", "exclusiveMinimum": 0},
    "fill_price": {"type": "number", "exclusiveMinimum": 0},
    "decision_at": {"type": "string", "format": "date-time"},
    "submitted_at": {"type": "string", "format": "date-time"},
    "accepted_at": {"type": "string", "format": "date-time"},
    "filled_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "source_packet_path": {"type": "string", "minLength": 1},
    "source_packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "broker_receipt_path": {"type": "string", "minLength": 1},
    "broker_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "broker_sync_receipt_path": {"type": "string", "minLength": 1},
    "broker_sync_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "slippage_vs_decision_bps": {"type": "number"},
    "slippage_vs_arrival_bps": {"type": "number"},
    "slippage_vs_official_open_bps": {"type": "number"},
    "slippage_vs_vwap_bps": {"type": "number"},
    "fill_latency_ms": {"type": "number", "minimum": 0},
    "client_order_id": {"type": "string", "minLength": 1},
    "signal_id": {"type": "string", "minLength": 1},
    "authorization_id": {"type": "string", "minLength": 1},
    "order_style": {"type": "string", "minLength": 1},
    "time_in_force": {"type": "string", "minLength": 1},
    "currency": {"type": "string", "minLength": 1},
    "venue": {"type": "string", "minLength": 1},
    "metadata": {"type": "object"},
    "ingested_at": {"type": "string", "format": "date-time"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OptionBacktestRun",
  "type": "object",
  "required": [
    "run_id",
    "overlay_name",
    "underlying_strategy",
    "symbol",
    "overlay_type",
    "trades",
    "skipped_trades",
    "start_equity",
    "end_equity",
    "total_return_pct"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "overlay_name": {"type": "string"},
    "underlying_strategy": {"type": "string"},
    "symbol": {"type": "string"},
    "overlay_type": {"enum": ["long_call", "debit_call_spread"]},
    "trades": {"type": "integer"},
    "skipped_trades": {"type": "integer"},
    "start_equity": {"type": "number"},
    "end_equity": {"type": "number"},
    "total_return_pct": {"type": "number"},
    "underlying_total_return_pct": {"type": ["number", "null"]},
    "underlying_trades": {"type": ["integer", "null"]},
    "assumptions": {"type": "array", "items": {"type": "string"}},
    "report_path": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}

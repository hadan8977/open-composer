{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-composer.local/schemas/multiscale_low_turnover_r6_feature_packet.schema.json",
  "title": "R6 Point-In-Time Event Feature Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "symbol", "modality", "published_at", "fetched_at", "visible_at", "source", "input_hash", "prompt_hash", "dedupe_key", "evidence_spans", "scores"],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"type": "string", "minLength": 1},
    "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,9}$"},
    "modality": {"enum": ["sec_filing", "news", "earnings_release", "earnings_calendar", "earnings_call"]},
    "published_at": {"type": "string", "format": "date-time"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "visible_at": {"type": "string", "format": "date-time"},
    "source": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dedupe_key": {"type": "string", "minLength": 1},
    "source_document_id": {"type": "string", "minLength": 1},
    "source_url": {"type": "string", "format": "uri"},
    "model_id": {"type": ["string", "null"]},
    "evidence_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_locator", "start", "end", "quote"],
        "properties": {
          "source_locator": {"type": "string", "minLength": 1},
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 1},
          "quote": {"type": "string", "minLength": 1}
        }
      }
    },
    "scores": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalyst_strength", "risk_event_score", "novelty", "guidance_change", "qa_challenge"],
      "properties": {
        "catalyst_strength": {"type": "number", "minimum": -1, "maximum": 1},
        "risk_event_score": {"type": "number", "minimum": 0, "maximum": 1},
        "novelty": {"type": "number", "minimum": 0, "maximum": 1},
        "guidance_change": {"type": "number", "minimum": -1, "maximum": 1},
        "qa_challenge": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}

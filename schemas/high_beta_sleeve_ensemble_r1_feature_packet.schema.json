{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-composer.local/schemas/high_beta_sleeve_ensemble_r1_feature_packet.schema.json",
  "title": "High-Beta Sleeve Ensemble R1 Forward Semantic Feature Packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "timestamp",
    "symbol",
    "published_at",
    "fetched_at",
    "visible_at",
    "source",
    "source_document_id",
    "input_hash",
    "prompt_hash",
    "model",
    "model_parameters_hash",
    "structured_output_hash",
    "dedupe_key",
    "acquisition_mode",
    "features",
    "evidence",
    "semantic_stock_budget",
    "order_authority",
    "broker_writes"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "packet_id": {"type": "string", "pattern": "^hbsr1_[a-f0-9]{24}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "symbol": {"type": "string", "pattern": "^(\\*|[A-Z][A-Z0-9.-]{0,15})$"},
    "published_at": {"type": "string", "format": "date-time"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "visible_at": {"type": "string", "format": "date-time"},
    "source": {"const": "news.alpaca"},
    "source_document_id": {"type": "string", "minLength": 1},
    "input_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "prompt_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "model": {"type": "string", "minLength": 1},
    "model_parameters_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "structured_output_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dedupe_key": {"type": "string", "minLength": 1},
    "acquisition_mode": {"const": "live_api_forward_only"},
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme_id",
        "event_type",
        "impact_subjects",
        "entities",
        "relationships",
        "direction",
        "confidence",
        "novelty",
        "horizon_sessions",
        "evidence_packet_ids",
        "unknown_fields"
      ],
      "properties": {
        "theme_id": {"type": "string"},
        "event_type": {"type": "string"},
        "impact_subjects": {"type": "array", "items": {"type": "string"}},
        "entities": {"type": "array", "items": {"type": "string"}},
        "relationships": {"type": "array", "items": {"type": "object"}},
        "direction": {"type": "number", "minimum": -1, "maximum": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "novelty": {"type": "number", "minimum": 0, "maximum": 1},
        "horizon_sessions": {"type": "integer", "minimum": 3, "maximum": 20},
        "evidence_packet_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "unknown_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "single_modality_baseline_metric",
        "marginal_lift_metric",
        "missing_modality_robustness"
      ],
      "properties": {
        "single_modality_baseline_metric": {"type": "string", "minLength": 1},
        "marginal_lift_metric": {"type": "string", "minLength": 1},
        "missing_modality_robustness": {"type": "string", "minLength": 1},
        "notes": {"type": "string"}
      }
    },
    "placebo": {"type": "boolean"},
    "placebo_seed": {"type": ["integer", "null"]},
    "semantic_stock_budget": {"const": 0.0},
    "order_authority": {"const": false},
    "broker_writes": {"const": false}
  }
}

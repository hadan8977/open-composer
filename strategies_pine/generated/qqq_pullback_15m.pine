//@version=6
indicator("Qqq Pullback 15M", overlay=true)

entryCondition = barstate.isconfirmed and (((close > ta.ema(close, 5)) and (ta.rsi(close, 3) < 75) and (volume > ta.sma(volume, 3))))
exitCondition = barstate.isconfirmed and (((ta.rsi(close, 3) > 82) or (close < ta.ema(close, 5))))

plotshape(entryCondition, title="Entry", style=shape.triangleup, location=location.belowbar, color=color.new(color.green, 0), size=size.tiny)
plotshape(exitCondition, title="Exit", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.tiny)

alertcondition(entryCondition, title="qqq_pullback_15m entry", message="qqq_pullback_15m entry {ticker} {interval} close={close}")
alertcondition(exitCondition, title="qqq_pullback_15m exit", message="qqq_pullback_15m exit {ticker} {interval} close={close}")

// Assumptions: bar-close signals; Python backtests fill on next bar open.
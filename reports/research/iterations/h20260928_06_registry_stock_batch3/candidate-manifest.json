        "glob": "data/sip/daily/*/*.parquet",
        "hygiene": "drop bars with zero volume and zero trade_count",
        "symbols": ["SPY", "QQQ", "SHY", "BIL"]
      }
    },
    "features": {
      "feature_v1_momentum_252_21_topk": {
        "signal": "load_signal(market, source='data/features/daily_broad', column='momentum_252_21', lag=0)",
        "direction": 1
      },
      "feature_v1_dist_from_252d_high_topk": {
        "signal": "load_signal(market, source='data/features/daily_broad', column='dist_from_252d_high', lag=0)",
        "direction": 1,
        "note": "column range is [-1, 0]; 0 = at the 52-week high; direction=1 (no negation) already selects the top-k closest to 0"
      },
      "feature_v1_vam_momentum_vol63_topk": {
        "signal": "momentum_252_21 / vol_63, both from data/features/daily_broad, elementwise, lag=0",
        "direction": 1
      },
      "feature_v1_13d_item4_event": {
        "signal": "SELECT issuer_symbol AS symbol, visible_session AS trade_date, 1.0 AS value FROM read_parquet('data/features/sec_13d/filings.parquet') WHERE item4_present=true AND is_new_13d=true",
        "note": "visible_session (not entry_session) is used as trade_date so signal_card's own next-open entry convention (in at open of t+1) reproduces entry_session exactly"
      },
      "feature_v1_monday_close_vs_open": {
        "signal": "sign(close[Monday] - open[Monday]); 1.0 -> hold the asset; else cash",
        "decision_lag_sessions": 0,
        "disclosed_deviation": "the source paper's own signal is Monday-12:00-vs-open (intraday); daily bars for both SPY and QQQ do not carry a consistent intraday print, so this round substitutes Monday's own close-vs-open as the observable proxy, explicitly disclosed"
      },
      "feature_v1_overnight_static_policy": {
        "signal": "constant: always hold the asset from close(t-1) to open(t); flat open(t) to close(t)",
        "decision_lag_sessions": 0
      }
    },
    "labels": {
      "label_v1_next_open_to_open_topk": {
        "definition": "signal_card.topk_cohorts(signal, eligible, k) -> signal_card.hold(cohorts, h) -> signal_card.book_returns(held, market.next_open_returns(), cost_bps)"
      },
      "label_v1_calendar_time_event_hold": {
        "definition": "signal_card.hold(events.astype(float32), h, normalize=True) -> signal_card.book_returns(held, market.next_open_returns(), cost_bps); every event stock held with equal weight for h sessions from its next-open entry"
      },
      "label_v1_weekly_next_open_piecewise": {
        "definition": "base.weights_from_selection(index, monday_signal_dates, picks, columns) -> base.portfolio_returns(weights, close, open_, cost_bps); piecewise-constant weight, effective at the open of the session after each Monday"
      },
      "label_v1_daily_overnight_round_trip": {
        "definition": "ret = open[t]/close[t-1] - 1 - 2*cost_bps/1e4 every session (2x cost for the explicit daily buy-then-flatten round trip)"
      }
    },
    "validation": {

{"claim_id": "qqq-reference-recovery-20261010:source-research", "claim": "Historical stock bars offer raw (unadjusted), split (price and volume), dividend (cash-dividend price), spin-off (price), and all (their composite).", "source_url": "https://docs.alpaca.markets/us/reference/stockbars", "source_type": "provider_official_docs", "accessed_at": "2026-10-10", "accessed_at_utc": "2026-10-10T16:00:38.425163+00:00", "applies_to": ["qqq_reference_recovery", "data_provider_specs", "intraday_execution"], "impact_on_spec": "Explicit provider raw minute bars are an existing solution to price basis recovery; do not equate all with dividend-only.", "limitations": "Current endpoint semantics do not identify parameters used to create the original local archive.", "status": "verified_documentation_claim", "query": {"url": "https://docs.alpaca.markets/us/reference/stockbars", "local_snapshot_find": "adjustment"}, "snapshot_path": "reports/research/program/qqq-reference-recovery-20261010/sources/stockbars.html", "snapshot_sha256": "76540f106ef13e5e90cca374938e21ab2e0c17eeea72c9b2e41d79ac35830df1", "text_snapshot_path": "reports/research/program/qqq-reference-recovery-20261010/sources/stockbars.txt", "text_snapshot_sha256": "866fbd61ae8217b7d0a67a605fc714f5b7cfc49bc41c2d078c472db1530687ee", "text_lines": [369, 378], "actual_market_inputs_verified": false, "pit_vintage_pass": false, "claim_key": "adjustment-modes"}
{"claim_id": "qqq-reference-recovery-20261010:asof-symbol-mapping", "claim": "asof selects the underlying symbol/entity mapping around ticker renames.", "source_url": "https://docs.alpaca.markets/us/reference/stockbars", "source_type": "provider_official_docs", "accessed_at": "2026-10-10", "accessed_at_utc": "2026-10-10T16:00:38.425163+00:00", "applies_to": ["qqq_reference_recovery", "data_provider_specs", "intraday_execution"], "impact_on_spec": "Never use asof as a historical adjustment/revision vintage selector.", "limitations": "Inference: this documented symbol-mapping parameter supplies no PIT data-vintage guarantee.", "status": "verified_documentation_claim", "query": {"url": "https://docs.alpaca.markets/us/reference/stockbars", "local_snapshot_find": "asof"}, "snapshot_path": "reports/research/program/qqq-reference-recovery-20261010/sources/stockbars.html", "snapshot_sha256": "76540f106ef13e5e90cca374938e21ab2e0c17eeea72c9b2e41d79ac35830df1", "text_snapshot_path": "reports/research/program/qqq-reference-recovery-20261010/sources/stockbars.txt", "text_snapshot_sha256": "866fbd61ae8217b7d0a67a605fc714f5b7cfc49bc41c2d078c472db1530687ee", "text_lines": [379, 384], "actual_market_inputs_verified": false, "pit_vintage_pass": false}
{"claim_id": "qqq-reference-recovery-20261010:bar-clock", "claim": "Minute bars use start labels for half-open minute intervals; daily bars use New York day labels derived from SIP trade timestamps.", "source_url": "https://docs.alpaca.markets/us/docs/market-data-faq", "source_type": "provider_official_docs", "accessed_at": "2026-10-10", "accessed_at_utc": "2026-10-10T16:00:39.080970+00:00", "applies_to": ["qqq_reference_recovery", "data_provider_specs", "intraday_execution"], "impact_on_spec": "09:59 is a completed input at 10:00; a daily timestamp is not the time its final close became visible.", "limitations": "Event label alone does not certify original publication, receipt or correction vintage.", "status": "verified_documentation_claim", "query": {"url": "https://docs.alpaca.markets/us/docs/market-data-faq", "local_snapshot_find": "How are bars aggregated?"}, "snapshot_path": "reports/research/program/qqq-reference-recovery-20261010/sources/market-data-faq.html", "snapshot_sha256": "fb80eb1b8cbc6978400a1db00795e35e369fc1ccdd51739be46eadda7728c7a2", "text_snapshot_path": "reports/research/program/qqq-reference-recovery-20261010/sources/market-data-faq.txt", "text_snapshot_sha256": "3c491205445cad8e967564e1fb4ba0873d9515ca90690381ce9a8268d5281fb2", "text_lines": [305, 306], "actual_market_inputs_verified": false, "pit_vintage_pass": false}
{"claim_id": "qqq-reference-recovery-20261010:daily-minute-eligibility", "claim": "Aggregation eligibility can differ by bar type. Corrected Consolidated Close condition 9 updates daily open/close but does not update minute fields.", "source_url": "https://docs.alpaca.markets/us/docs/market-data-faq", "source_type": "provider_official_docs", "accessed_at": "2026-10-10", "accessed_at_utc": "2026-10-10T16:00:39.080970+00:00", "applies_to": ["qqq_reference_recovery", "data_provider_specs", "intraday_execution"], "impact_on_spec": "Daily close and final regular-session minute close are not guaranteed identical; their ratio can contain an endpoint mismatch.", "limitations": "The official rule is counterevidence to automatic equivalence, not proof of a discrepancy in these QQQ files.", "status": "verified_documentation_claim", "query": {"url": "https://docs.alpaca.markets/us/docs/market-data-faq", "local_snapshot_find": "9Corrected Consolidated Close"}, "snapshot_path": "reports/research/program/qqq-reference-recovery-20261010/sources/market-data-faq.html", "snapshot_sha256": "fb80eb1b8cbc6978400a1db00795e35e369fc1ccdd51739be46eadda7728c7a2", "text_snapshot_path": "reports/research/program/qqq-reference-recovery-20261010/sources/market-data-faq.txt", "text_snapshot_sha256": "3c491205445cad8e967564e1fb4ba0873d9515ca90690381ce9a8268d5281fb2", "text_lines": [364, 381], "actual_market_inputs_verified": false, "pit_vintage_pass": false}
{"claim_id": "qqq-reference-recovery-20261010:provider-vwap", "claim": "Provider VWAP weights eligible trades; its denominator can differ from the ordinary volume field.", "source_url": "https://docs.alpaca.markets/us/docs/market-data-faq", "source_type": "provider_official_docs", "accessed_at": "2026-10-10", "accessed_at_utc": "2026-10-10T16:00:39.080970+00:00", "applies_to": ["qqq_reference_recovery", "data_provider_specs", "intraday_execution"], "impact_on_spec": "Keep the local cumulative typical-price-times-volume proxy separate from provider VWAP.", "limitations": "Local proxy equality to a trade-based VWAP cannot be inferred from identical field names.", "status": "verified_documentation_claim", "query": {"url": "https://docs.alpaca.markets/us/docs/market-data-faq", "local_snapshot_find": "VWAP is the ratio"}, "snapshot_path": "reports/research/program/qqq-reference-recovery-20261010/sources/market-data-faq.html", "snapshot_sha256": "fb80eb1b8cbc6978400a1db00795e35e369fc1ccdd51739be46eadda7728c7a2", "text_snapshot_path": "reports/research/program/qqq-reference-recovery-20261010/sources/market-data-faq.txt", "text_snapshot_sha256": "3c491205445cad8e967564e1fb4ba0873d9515ca90690381ce9a8268d5281fb2", "text_lines": [379, 381], "actual_market_inputs_verified": false, "pit_vintage_pass": false}

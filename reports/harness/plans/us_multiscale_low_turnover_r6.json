    },
    {
      "domain": "daily_open_execution",
      "rule_id": "compare_at_least_two_execution_methods",
      "blocks": "research_pass",
      "description": "Execution policy must compare at least two order styles (e.g. DAY market vs. MOO/OPG vs. LOO/OPG).\n"
    },
    {
      "domain": "llm_or_news_signal",
      "rule_id": "no_live_llm_call_inside_backtest",
      "blocks": "research_pass",
      "description": "LLM and news calls must be replayed from PIT packets during backtest; live API calls inside the backtest loop are prohibited.\n"
    },
    {
      "domain": "llm_or_news_signal",
      "rule_id": "llm_alpha_requires_quant_baseline",
      "blocks": "research_pass",
      "description": "An LLM or news-driven strategy must include a deterministic (non-LLM) baseline and a marginal_lift_report showing additive value.\n"
    }
  ]

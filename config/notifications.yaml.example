version: 1
telegram:
  enabled: false
  bot_token_env: TELEGRAM_BOT_TOKEN
  chat_id_env: TELEGRAM_CHAT_ID
  parse_mode: MarkdownV2
  quiet_hours_local: null
policies:
  - kind: signal_actionable
    channels: [telegram, log_only]
    min_severity: info
  - kind: signal_paper_only
    channels: [log_only]
    min_severity: info
  - kind: kill_switch
    channels: [telegram, log_only]
    min_severity: red
  - kind: alpaca_error
    channels: [telegram, log_only]
    min_severity: warn
  - kind: system_alert
    channels: [telegram, log_only]
    min_severity: warn
  - kind: selector_recommendation
    channels: [log_only]
    min_severity: info
  - kind: regime_change
    channels: [log_only]
    min_severity: warn
  - kind: digest_daily
    channels: [log_only]
    min_severity: info

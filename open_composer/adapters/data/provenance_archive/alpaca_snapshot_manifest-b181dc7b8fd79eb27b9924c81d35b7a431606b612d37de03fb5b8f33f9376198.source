{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Immutable Alpaca Snapshot Manifest v2",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema_version",
        "iter_id",
        "bundle_role",
        "provider",
        "endpoint",
        "transport_contract",
        "sdk_package",
        "sdk_version",
        "retrieved_at",
        "contract_path",
        "contract_sha256",
        "contract_schema_path",
        "contract_schema_sha256",
        "manifest_schema_path",
        "manifest_schema_sha256",
        "collector_path",
        "collector_sha256",
        "calendar_path",
        "calendar_sha256",
        "output_root",
        "immutable",
        "overwrite_allowed",
        "request_count",
        "adjustment_policy",
        "inventory_count",
        "inventory",
        "publication_marker_path",
        "items",
    ],
    "properties": {
        "schema_version": {"const": 2},
        "iter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"},
        "bundle_role": {"enum": ["candidate_research", "selection_prohibited_execution_shadow"]},
        "provider": {"const": "alpaca"},
        "endpoint": {"const": "https://data.alpaca.markets/v2/stocks/bars"},
        "transport_contract": {"const": "exact_http_entity_bytes_v1"},
        "sdk_package": {"const": "alpaca-py"},
        "sdk_version": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "contract_path": {"type": "string", "minLength": 1},
        "contract_sha256": {"$ref": "#/$defs/sha256"},
        "contract_schema_path": {"const": "schemas/alpaca_snapshot_contract.schema.json"},
        "contract_schema_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_schema_path": {"const": "schemas/alpaca_snapshot_manifest.schema.json"},
        "manifest_schema_sha256": {"$ref": "#/$defs/sha256"},
        "collector_path": {"const": "open_composer/adapters/data/alpaca_snapshot.py"},
        "collector_sha256": {"$ref": "#/$defs/sha256"},
        "calendar_path": {"const": "open_composer/market_calendar.py"},
        "calendar_sha256": {"$ref": "#/$defs/sha256"},
        "output_root": {"type": "string", "minLength": 1},
        "immutable": {"const": true},
        "overwrite_allowed": {"const": false},
        "request_count": {"type": "integer", "minimum": 1},
        "adjustment_policy": {"$ref": "#/$defs/adjustmentPolicy"},
        "inventory_count": {"type": "integer", "minimum": 1},
        "inventory": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inventoryEntry"}},
        "publication_marker_path": {"const": "PUBLICATION_COMPLETE.json"},
        "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    },
    "$defs": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "adjustmentPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "requested_adjustments",
                "independently_retrieved",
                "all_equivalence_assumed",
                "spin_off_support",
                "all_adjustment_risk",
            ],
            "properties": {
                "requested_adjustments": {
                    "type": "array",
                    "items": {"enum": ["raw", "split", "dividend", "all"]},
                    "minItems": 1,
                    "uniqueItems": true,
                },
                "independently_retrieved": {"const": true},
                "all_equivalence_assumed": {"const": false},
                "spin_off_support": {
                    "const": "provider_all_composite_only_no_independent_decomposition"
                },
                "all_adjustment_risk": {
                    "const": "Alpaca adjustment=all is an independently retrieved provider composite that may include split, cash-dividend, and spin-off effects; it is not derived from or assumed equivalent to the raw, split, and dividend responses."
                },
            },
        },
        "inventoryEntry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "role", "size_bytes", "sha256"],
            "properties": {
                "path": {"type": "string", "minLength": 1},
                "role": {"enum": ["raw_http_entity", "normalized_csv", "item_manifest"]},
                "size_bytes": {"type": "integer", "minimum": 1},
                "sha256": {"$ref": "#/$defs/sha256"},
            },
        },
        "page": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "page_number",
                "path",
                "record_count",
                "request_page_token",
                "response_next_page_token",
                "status_code",
                "content_type",
                "content_encoding",
                "entity_byte_count",
                "sha256",
            ],
            "properties": {
                "page_number": {"type": "integer", "minimum": 1},
                "path": {"type": "string", "minLength": 1},
                "record_count": {"type": "integer", "minimum": 0},
                "request_page_token": {"type": ["string", "null"]},
                "response_next_page_token": {"type": ["string", "null"]},
                "status_code": {"const": 200},
                "content_type": {"type": "string", "minLength": 1},
                "content_encoding": {"const": "identity"},
                "entity_byte_count": {"type": "integer", "minimum": 1},
                "sha256": {"$ref": "#/$defs/sha256"},
            },
        },
        "quality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "status",
                "expected_session_count",
                "observed_session_count",
                "complete_sessions",
                "duplicate_timestamp_count",
                "missing_timestamps",
                "nonfinite_count",
            ],
            "properties": {
                "status": {"const": "complete"},
                "expected_session_count": {"type": "integer", "minimum": 1},
                "observed_session_count": {"type": "integer", "minimum": 1},
                "expected_bar_count": {"type": "integer", "minimum": 1},
                "observed_bar_count": {"type": "integer", "minimum": 1},
                "provider_off_session_bar_count": {"type": "integer", "minimum": 0},
                "complete_sessions": {
                    "type": "array",
                    "items": {"type": "string", "format": "date"},
                },
                "duplicate_timestamp_count": {"const": 0},
                "missing_timestamps": {"type": "array", "maxItems": 0},
                "nonfinite_count": {"const": 0},
            },
        },
        "item": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "symbol",
                "timeframe",
                "feed",
                "adjustment",
                "adjustment_semantics",
                "all_equivalence_assumed",
                "session_scope",
                "requested_start",
                "requested_end_exclusive",
                "symbol_asof",
                "symbol_asof_semantics",
                "requested_currency",
                "response_currency",
                "response_currency_status",
                "retrieved_at",
                "request_params",
                "row_count",
                "first_timestamp",
                "last_timestamp",
                "page_count",
                "pages",
                "raw_pages_aggregate_sha256",
                "normalized_sha256",
                "output_path",
                "output_sha256",
                "quality",
            ],
            "properties": {
                "symbol": {"type": "string", "pattern": "^[A-Z][A-Z0-9.-]{0,14}$"},
                "timeframe": {"type": "string", "minLength": 1},
                "feed": {"const": "sip"},
                "adjustment": {"enum": ["raw", "split", "dividend", "all"]},
                "adjustment_semantics": {
                    "enum": [
                        "unadjusted",
                        "split_adjusted",
                        "cash_dividend_adjusted",
                        "provider_all_composite_may_include_spin_offs",
                    ]
                },
                "all_equivalence_assumed": {"const": false},
                "session_scope": {"const": "regular"},
                "requested_start": {"type": "string", "format": "date-time"},
                "requested_end_exclusive": {"type": "string", "format": "date-time"},
                "symbol_asof": {"type": "string", "format": "date"},
                "symbol_asof_semantics": {
                    "const": "symbol_mapping_only_not_historical_data_vintage"
                },
                "requested_currency": {"const": "USD"},
                "response_currency": {"type": ["string", "null"], "enum": ["USD", null]},
                "response_currency_status": {"enum": ["declared", "not_declared_by_bars_endpoint"]},
                "retrieved_at": {"type": "string", "format": "date-time"},
                "request_params": {"type": "object"},
                "row_count": {"type": "integer", "minimum": 1},
                "first_timestamp": {"type": "string", "format": "date-time"},
                "last_timestamp": {"type": "string", "format": "date-time"},
                "page_count": {"type": "integer", "minimum": 1},
                "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
                "raw_pages_aggregate_sha256": {"$ref": "#/$defs/sha256"},
                "normalized_sha256": {"$ref": "#/$defs/sha256"},
                "output_path": {"type": "string", "minLength": 1},
                "output_sha256": {"$ref": "#/$defs/sha256"},
                "quality": {"$ref": "#/$defs/quality"},
            },
        },
    },
}

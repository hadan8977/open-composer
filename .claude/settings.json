{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/UserPromptSubmit-harness-context.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/PreToolUse-paper-write-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/Stop-artifact-summary.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run oc *)",
      "Bash(uv run ruff format .)",
      "Bash(uv run ruff check .)",
      "Bash(uv run pytest*)",
      "Bash(uv run python scripts/check-agent-parity.py)",
      "Bash(uv run python scripts/sync-agent-skills.py)",
      "Bash(make agent-parity)",
      "Bash(make verify)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(uv run ruff format *)",
      "Bash(uv run ruff check *)",
      "Bash(crontab -l)",
      "Bash(pgrep *)",
      "mcp__gdrive__drive_job",
      "mcp__gdrive__drive_ls",
      "mcp__gdrive__drive_df",
      "mcp__gdrive__drive_stat",
      "mcp__paseo__browser_screenshot",
      "mcp__paseo__browser_snapshot",
      "mcp__paseo__list_providers",
      "mcp__paseo__inspect_provider",
      "mcp__paseo__get_agent_activity",
      "mcp__paseo__list_models",
      "mcp__paseo__list_agents",
      "mcp__paseo__get_agent_status"
    ],
    "ask": [
      "Bash(uv run oc paper submit*)",
      "Bash(uv run oc dashboard command-run*)",
      "Bash(git push*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*private*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(rm -rf *)",
      "Bash(printenv*)",
      "Bash(env*)"
    ]
  }
}
